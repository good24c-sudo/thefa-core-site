{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "version": 2,
 "framework": null,
 "buildCommand": null,
 "outputDirectory": "customer-public",
 "public": false,
 "functions": {
  "api/dispatch.mjs": {
   "maxDuration": 60,
   "includeFiles": "private-data/migration/**"
  }
 },
 "rewrites": [
  {
   "source": "/server/:path*",
   "destination": "/api/source-denied"
  },
  {
   "source": "/api/customer/:path*",
   "destination": "/api/dispatch?__customer_route=/api/customer/:path*"
  },
  {
   "source": "/api/auth/:path*",
   "destination": "/api/dispatch?__customer_route=/api/auth/:path*"
  },
  {
   "source": "/auth/:path*",
   "destination": "/api/dispatch?__customer_route=/auth/:path*"
  },
  {
   "source": "/functions/v1/core-customer-auth/callback/:provider/oauth-proxy",
   "destination": "/api/dispatch?__customer_route=/functions/v1/core-customer-auth/callback/:provider/oauth-proxy"
  },
  {
   "source": "/about",
   "destination": "/about.html"
  },
  {
   "source": "/about/",
   "destination": "/about.html"
  },
  {
   "source": "/login",
   "destination": "/login.html"
  },
  {
   "source": "/signup",
   "destination": "/signup.html"
  },
  {
   "source": "/plans",
   "destination": "/plans.html"
  },
  {
   "source": "/install",
   "destination": "/install.html"
  },
  {
   "source": "/chat.html",
   "destination": "/index.html"
  },
  {
   "source": "/guest-live.html",
   "destination": "/index.html"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
   ]
  }
 ]
}
